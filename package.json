{
  "name": "sleeby",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "lint": "turbo run lint && eslint scripts packages/config eslint.config.mjs && node scripts/check-layering.mjs && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/test/*.test.mjs",
    "build": "turbo run build",
    "test:contracts": "pnpm build && node scripts/package-contracts.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:packages": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "@microsoft/tsdoc": "0.17.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
